{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dioxuscut.dev/schema/project/v1.json",
  "title": "Dioxuscut Project v1",
  "type": "object",
  "required": ["version", "composition", "settings"],
  "properties": {
    "version": { "const": 1 },
    "composition": { "type": "string", "minLength": 1 },
    "settings": {
      "type": "object",
      "required": ["width", "height", "fps", "duration"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "duration": { "type": "integer", "minimum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "crf": { "type": ["integer", "null"], "minimum": 0 },
        "preset": { "type": ["string", "null"], "minLength": 1 },
        "concurrency": { "type": ["integer", "null"], "minimum": 1 },
        "frame_step": { "type": "integer", "minimum": 1 },
        "frame_start": { "type": "integer", "minimum": 0 },
        "frame_end": { "type": "integer", "minimum": 0 },
        "backend": { "enum": ["native", "browser", "gpu"] },
        "browser_image_format": { "enum": ["png", "jpeg"] },
        "browser_jpeg_quality": { "type": "integer", "minimum": 1, "maximum": 100 },
        "browser_frame_timeout_ms": { "type": "integer", "minimum": 1 },
        "browser_transport": { "enum": ["base64", "file"] },
        "browser_transport_retries": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "props": {},
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/timeEvent" }
    },
    "voice_over_asset_id": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["other", "image", "video", "audio", "font", "lottie", "model", "shader"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } }
      },
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "required": ["id", "composition", "start", "duration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 1 },
        "props": {}
      },
      "additionalProperties": false
    },
    "timeEvent": {
      "type": "object",
      "required": ["id", "frame"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "frame": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
